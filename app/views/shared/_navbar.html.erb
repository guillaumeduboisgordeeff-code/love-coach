<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon sticky-top"> <!-- Barre de navigation -->
  <div class="container-fluid"> <!-- Conteneur de la navbar -->
    <%= link_to root_path, class: "navbar-brand" do %> <!-- Le logo renvoie vers l’accueil -->
      <%= image_tag "love-coach-logo.png", alt: "Love Coach" %> <!-- Image du logo -->
    <% end %> <!-- Fin du lien du logo -->

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Ouvrir le menu"> <!-- Bouton du menu sur petit écran -->
      <span class="navbar-toggler-icon"></span> <!-- Icône du bouton -->
    </button> <!-- Fin du bouton du menu -->

    <div class="collapse navbar-collapse" id="navbarSupportedContent"> <!-- Contenu repliable de la navbar -->
      <ul class="navbar-nav me-auto"> <!-- Liste des liens de navigation -->
        <li class="nav-item">
          <%= link_to "Nos Souls", anciens_souls_path, class: "nav-link" %>
        </li>
        <% if user_signed_in? %> <!-- Vérifie si l’utilisateur est connecté -->
          <li class="nav-item"> <!-- Élément du menu Masterplans -->
            <%= link_to "Masterplans", masterplans_path, class: "nav-link" %> <!-- Lien vers les Masterplans -->
          </li> <!-- Fin de l’élément Masterplans -->

          <li class="nav-item dropdown profil"> <!-- Menu déroulant du profil -->
            <a href="#" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <!-- Bouton du menu profil -->
              <%= image_tag "user1.jpg", class: "avatar", alt: "Menu utilisateur" %> <!-- Image de l’utilisateur -->
            </a> <!-- Fin du bouton du menu profil -->

            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown"> <!-- Options du menu profil -->
              <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %> <!-- Lien de déconnexion -->
            </div> <!-- Fin des options du menu profil -->
          </li> <!-- Fin du menu profil -->
        <% else %> <!-- Affiche le lien suivant si l’utilisateur n’est pas connecté -->
          <li class="nav-item"> <!-- Élément du menu de connexion -->
            <%= link_to "Connexion", new_user_session_path, class: "nav-link" %> <!-- Lien vers la connexion -->
          </li> <!-- Fin de l’élément de connexion -->
        <% end %> <!-- Fin de la condition de connexion -->
      </ul> <!-- Fin de la liste des liens -->
    </div> <!-- Fin du contenu repliable -->
  </div> <!-- Fin du conteneur -->
</nav> <!-- Fin de la navbar -->
