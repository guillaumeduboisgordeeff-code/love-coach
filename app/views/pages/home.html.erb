<section class="home-hero">
  <div class="home-heading">
    <h1 class="home-title">Bienvenue sur</h1>
    <%= image_tag "love-coach-logo.png", alt: "Love Coach", class: "home-logo" %>
  </div>

  <div class="granny-arch" aria-hidden="true">
    <div class="granny-ring">
      <% photos = %w[riche1.jpeg riche2.jpg riche3.jpg riche4.jpg riche5.jpeg
                     riche6.jpg riche7.jpg riche8.jpg riche9.jpeg riche10.jpg] %>
      <% photos.each_with_index do |photo, i| %>
        <div class="granny-slot" style="--angle: <%= i * 36 %>deg;">
          <div class="granny-face">
            <%= image_tag photo, alt: "" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if user_signed_in? %>
    <%# Le coach se penche dans l'écran depuis la gauche %>
    <div class="coach coach--lean" aria-hidden="true">
      <%= image_tag "the_coach.png", alt: "", class: "coach-img" %>
    </div>
  <% else %>
    <%# Seul le torse du coach dépasse, sous l'arche, et il parle dans une bulle %>
    <div class="coach coach--peek">
      <%= image_tag "the_coach.png", alt: "", class: "coach-img" %>
      <p class="speech-bubble">Ta carrière ne décolle pas ?<br>Tu stagnes dans ta vie ?</p>
    </div>
  <% end %>

  <div class="home-cta <%= "home-cta--guest" unless user_signed_in? %>">
    <% if user_signed_in? %>
      <%# Explosion d'emojis puis POST /chats : voir controllers/heart_burst_controller.js %>
      <%= link_to "Rencontrer un riche", chats_path, data: { controller: "heart-burst", action: "heart-burst#explode" }, class: "btn-heart" %>
    <% else %>
      <%= link_to "Connecte-toi et rencontre un riche !", new_user_session_path, class: "btn btn-get-rich" %>
    <% end %>
  </div>
</section>
