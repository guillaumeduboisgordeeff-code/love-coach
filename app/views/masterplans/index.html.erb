
<section class="masterplans-page">
  <div class="masterplans-shell">
    <%# Hero : titre, puis le coach qui flambe ses billets à côté du gros cœur %>
    <div class="masterplans-hero">
      <header class="masterplans-heading">
        <h1>Mes plans pour rencontrer un riche</h1>
        <p>Chaque histoire de succès commence par la rencontre d'un riche.</p>
      </header>

      <div class="masterplans-finale">
        <%= image_tag "love-coach-flex-money.png", alt: "", class: "masterplans-coach", aria: { hidden: true } %>
        <%= button_to (@masterplans.empty? ? "Définir une cible" : "Nouvelle séduction !"), chats_path,
            class: "masterplans-cta",
            form: { class: "masterplans-cta-form" } %>
      </div>
    </div>

    <% if @masterplans.empty? %>
      <section class="masterplans-empty">
        <h2>Tu es tout seul ?</h2>
        <p>Ta vie sentimentale ne va pas se faire toute seule.</p>

      </section>

    <% else %>
      <section class="masterplans-list" aria-label="Mes aventures">

        <% @masterplans.each_with_index do |masterplan, index| %>
          <% tasks = masterplan.tasks.to_a %>
          <% completed_tasks = tasks.count(&:done?) %>
          <% total_tasks = tasks.count %>
          <% progress = total_tasks.zero? ? 0 : (completed_tasks.to_f / total_tasks * 100).round %>

          <article class="masterplan-entry">

            <div class="masterplan-entry-copy">
              <h2><%= masterplan.woman_name %></h2>

              <p>
                <%= completed_tasks %> / <%= total_tasks %> tâches terminées
              </p>

              <div class="masterplan-progress">
                <div
                  class="masterplan-progress-bar"
                  style="width: <%= progress %>%">
                </div>
              </div>

              <span class="masterplan-percentage">
                <%= progress %> % terminé
              </span>
            </div>
            <div class="masterplan-actions">
              <%= button_to "Découvrir mon destin",
                  masterplan_path(masterplan),
                  method: :get,
                  class: "masterplan-action-button" %>

              <%= button_to "Supprimer",
                  masterplan_path(masterplan),
                  method: :delete,
                  class: "masterplan-action-button",
                  data: { turbo_confirm: "Tu veux vraiment supprimer ce plan et toutes ses tâches ?" } %>
              </div>

          </article>
        <% end %>

      </section>


    <% end %>
  </div>
</section>
