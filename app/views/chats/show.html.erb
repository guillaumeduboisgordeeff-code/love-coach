<div class="row">
  <div class="col">
    <h1><%= @chat.title %></h1>
     <div class="messages">
        <%= render partial: "message", collection: @messages %>
     </div>
     <%= simple_form_for [@chat, @message], html: { class: "mt-4" } do |f| %>
      <%= f.input :content,
            as: :text,
            label: false,
            placeholder: "Écris ton message…",
            input_html: { rows: 3 } %>
      <%= f.button :submit, "Envoyer", class: "btn btn-primary" %>
<% end %>
  </div>
</div>
