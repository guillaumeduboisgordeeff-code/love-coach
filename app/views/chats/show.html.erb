<div class="row">
  <div class="col">
    <h1 id="chat_title"><%= @chat.title %></h1>
     <div class="messages" id="messages">
        <%= render partial: "chats/message", collection: @messages %>
     </div>
     <div id="new_message_container">
        <%= render "messages/form", chat: @chat, message: @message %>
     </div>
  </div>
</div>
