<%# coach-voice : sons quand le coach répond (controllers/coach_voice_controller.js) %>
<div class="row chat-page"
     data-controller="coach-voice"
     data-coach-voice-talk-value="<%= audio_path("talk.mp3") %>"
     data-coach-voice-talk-reverse-value="<%= audio_path("talkreverse.mp3") %>"
     data-coach-voice-question-value="<%= audio_path("question.mp3") %>"
     data-coach-voice-validation-value="<%= audio_path("validationrire.mp3") %>">
  <div class="col" data-controller="chat" data-action="turbo:submit-start->chat#showPending turbo:submit-end->chat#clearPending">
    <template data-chat-target="pending">
      <div class="message message--user" data-pending>
        <div class="message__bubble" data-pending-content></div>
      </div>
      <div class="message message--assistant" data-pending>
        <div class="message__bubble">…</div>
      </div>
    </template>
    <h1 id="chat_title"><%= @chat.title %></h1>
     <div class="messages" id="messages" data-chat-target="messages">
        <%= render partial: "chats/message", collection: @messages %>
     </div>
     <div id="new_message_container">
        <%= render "messages/form", chat: @chat, message: @message %>
     </div>
  </div>
</div>

<%# Le coach, bras croisés, en bas au centre de l'écran (derrière le chat) %>
<%= image_tag "love-coach-croise-bras.png", alt: "", class: "chat-coach", aria: { hidden: true } %>
