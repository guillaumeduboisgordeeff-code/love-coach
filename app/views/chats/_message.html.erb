<%# On lit le masterplan une seule fois (préchargé par includes dans ChatsController#show) %>
<% masterplan = message.masterplan %>

<%# id = dom_id(message) : permet au broadcast de remplacer cette bulle pendant le streaming %>
<div class="message message--<%= message.role %>" id="<%= dom_id(message) %>">
  <%# Une seule bulle : si le message a généré un masterplan, on lui ajoute le modificateur
      BEM --masterplan, qui la transforme en carte (voir _message.scss) %>
  <div class="message__bubble <%= "message__bubble--masterplan" if masterplan %>" id="<%= dom_id(message, :content) %>">
      <%= render partial: "chats/message_content", locals: { message: message } %>
  </div>
</div>
