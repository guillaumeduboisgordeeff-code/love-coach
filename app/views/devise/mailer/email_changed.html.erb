<p>Bonjour <%= @email %> !</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>Petit message pour te prévenir que ton adresse e-mail va bientôt devenir : <%= @resource.unconfirmed_email %>.</p>
<% else %>
  <p>Petit message pour te prévenir que ta nouvelle adresse e-mail est : <%= @resource.email %>.</p>
<% end %>
