<h2>Modifier mon profil</h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :email, label: "Adresse e-mail", required: true, autofocus: true %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p>En attente de confirmation pour : <%= resource.unconfirmed_email %></p>
    <% end %>

    <%= f.input :password,
                label: "Nouveau mot de passe",
                hint: "laisse vide si tu ne veux pas le changer",
                required: false,
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :password_confirmation,
                label: "Confirme ton nouveau mot de passe",
                required: false,
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :current_password,
                label: "Mot de passe actuel",
                hint: "nécessaire pour confirmer tes modifications",
                required: true,
                input_html: { autocomplete: "current-password" } %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Enregistrer" %>
  </div>
<% end %>

<h3>Supprimer mon compte</h3>

<div>On se quitte déjà ? <%= button_to "Supprimer mon compte", registration_path(resource_name), data: { confirm: "Tu es sûr·e ? Cette rupture sera définitive.", turbo_confirm: "Tu es sûr·e ? Cette rupture sera définitive." }, method: :delete %></div>

<%= link_to "Retour", :back %>
